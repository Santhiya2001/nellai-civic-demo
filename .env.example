ENVIRONMENT=development
DEMO_MODE=false
JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./runtime/nellai.db
DISTRICT_NAME=Tirunelveli
TIMEZONE=Asia/Kolkata
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=
AI_URL=
MAX_UPLOAD_MB=8
RETENTION_DAYS=365
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Send one alert for every new complaint to this authority mailbox (blank disables alerts).
COMPLAINT_ALERT_EMAIL=
# Docker Compose reads these. Generate with scripts/configure.py --docker.
POSTGRES_DB=nellai
POSTGRES_USER=nellai
POSTGRES_PASSWORD=
